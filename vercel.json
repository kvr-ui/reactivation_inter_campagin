{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/webhook/caguru",
      "destination": "/api/webhook?source=caguru"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard2",
      "destination": "/dashboard2.html"
    },
    {
      "source": "/dashboard3",
      "destination": "/dashboard3.html"
    },
    {
      "source": "/caguru",
      "destination": "/caguru.html"
    },
    {
      "source": "/chat",
      "destination": "/chat.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/api/leads4/(.*)",
      "destination": "/api/leads4?waId=$1"
    },
    {
      "source": "/api/chat/(.*)",
      "destination": "/api/chat?path=$1"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  }
}
